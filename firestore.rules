rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {

    // Default deny all access
    match /{document=**} {
      allow read, write: if false;
    }

    // Helper functions
    function isSignedIn() {
      return request.auth != null;
    }

    function isOwner(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isValidId(id) {
      return id is string && id.size() <= 128 && id.matches('^[a-zA-Z0-9_\\-]+$');
    }

    function incoming() {
      return request.resource.data;
    }

    function existing() {
      return resource.data;
    }

    function isAdmin() {
      return isSignedIn() && (
        exists(/databases/$(database)/documents/admins/$(request.auth.uid)) ||
        (request.auth.token.email != null && (
          request.auth.token.email == 'b92225202@gmail.com' ||
          request.auth.token.email == 'retailer@glowcare.demo'
        ))
      );
    }

    // Connection test document
    match /test/connection {
      allow read: if true;
      allow write: if false;
    }

    // Admins registry
    match /admins/{adminId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    // User profiles
    match /users/{userId} {
      allow get: if isOwner(userId) || isAdmin();
      allow list: if isAdmin();
      allow create: if isOwner(userId) && (
        incoming().role == 'customer' || isAdmin()
      );
      allow update: if (isOwner(userId) && incoming().role == existing().role) || isAdmin();
      allow delete: if isAdmin();
    }

    // Products collection: public view, admin write
    match /products/{productId} {
      allow get, list: if true;
      allow create, update, delete: if isAdmin();
    }

    // Shopping Carts: private per customer
    match /carts/{userId} {
      allow read, write: if isOwner(userId) || isAdmin();
    }

    // Orders: customers create and read own orders; retailers manage all orders
    match /orders/{orderId} {
      allow get: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
      allow list: if isSignedIn() && (
        (resource.data.userId == request.auth.uid) || isAdmin()
      );
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update: if isAdmin() || (
        isSignedIn() && 
        resource.data.userId == request.auth.uid && 
        incoming().diff(existing()).affectedKeys().hasOnly(['paymentStatus', 'paymentId'])
      );
      allow delete: if isAdmin();
    }

    // Reviews: public read, authenticated author create
    match /reviews/{reviewId} {
      allow get, list: if true;
      allow create: if isSignedIn() && incoming().userId == request.auth.uid;
      allow update, delete: if isSignedIn() && (resource.data.userId == request.auth.uid || isAdmin());
    }
  }
}
